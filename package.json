{
  "name": "autoquotes-free",
  "version": "1.0.0",
  "license": "MIT",
  "description": "AutoQuotes Free for Linux: local automotive repair quotes, jobs and billing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,green \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "AUTO_SHUTDOWN=0 tsx watch src/main.ts",
    "dev:ui": "vite",
    "build": "tsc -p frontend/tsconfig.json && vite build && tsc -p tsconfig.server.json && mkdir -p dist/pdf/templates dist/database/migrations && cp src/pdf/templates/*.html dist/pdf/templates/ && cp src/database/migrations/*.sql dist/database/migrations/",
    "start": "AUTO_SHUTDOWN=1 node dist/main.js",
    "start:keep": "AUTO_SHUTDOWN=0 node dist/main.js",
    "setup": "bash scripts/setup.sh",
    "db:init": "tsx src/config/database.ts --init",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "handlebars": "^4.7.8",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1",
    "openai": "^6.49.0",
    "playwright": "^1.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "zustand": "^5.0.0"
  },
  "files": [
    "dist",
    "src",
    "frontend",
    "scripts",
    "tests",
    "data/vehicle-catalog.json",
    "tsconfig.json",
    "tsconfig.server.json",
    "vite.config.ts",
    "tailwind.config.js",
    "postcss.config.js"
  ]
}
